{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "db.json"
    },
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "db.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__path=$1"
    },
    {
      "source": "/push/(.*)",
      "destination": "/api/index.js?__path=push/$1"
    },
    {
      "source": "/((?!api/|push/|assets/|manifest\\.json|sw\\.js|icon-|apple-touch-|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
